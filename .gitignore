# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/transcript
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp/

# production
/build
/public/covers/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local publishing references and analysis artifacts
/publishing/references/

# APK reverse-engineering outputs are local source artifacts
/reversing/

# large local source databases (too big for GitHub's 100MB limit)
/db/

# typescript
*.tsbuildinfo
# python
__pycache__/
.opencode
.next
